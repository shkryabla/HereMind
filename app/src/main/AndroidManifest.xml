<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Запрашивается ОПЦИОНАЛЬНО, отдельным шагом из SettingsActivity (с Prominent
         Disclosure перед системным диалогом — см. requirements Google Play). Foreground-
         сервис с foregroundServiceType="location" формально получает координаты в фоне и
         без этого разрешения, но на части устройств доставка уведомлений обрывается после
         удаления задачи из списка последних приложений — выдача этого разрешения снимает
         ограничение. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".GeoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.GeoNapominalka"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.TaskEditActivity"
            android:exported="false"
            android:label="@string/title_task_edit" />
        <!-- Приём шаринга местоположения из других приложений (Google/Яндекс Карты и
             т.п. -> "Поделиться" -> напомниТут) и geo:-ссылок навигаторов. -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GeoNapominalka">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.TaskListActivity"
            android:exported="false"
            android:label="@string/title_task_list" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />
        <activity
            android:name=".ui.MapPickerActivity"
            android:exported="false"
            android:label="@string/title_map_picker" />
        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:label="@string/title_log" />
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/nav_about" />
        <!-- Foreground-сервис геолокации. Запускается только когда есть активные задачи -->
        <service
            android:name=".service.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Обработка кнопок "Выполнено" / "Отложить" в уведомлении -->
        <receiver
            android:name=".receiver.NotificationActionReceiver"
            android:exported="false" />
        <!-- Приём событий Activity Recognition (адаптивный алгоритм опроса местоположения) -->
        <receiver
            android:name=".service.ActivityTransitionReceiver"
            android:exported="false" />
    </application>
</manifest>
